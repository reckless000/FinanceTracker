<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.controllers.ViewTransactionsController"
      spacing="15"
      styleClass="tab-content"
      >
    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Transaction History" styleClass="section-title" HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshBtn" text="🔄  Refresh" styleClass="btn-primary"/>
    </HBox>
    <Separator/>

    <ListView fx:id="transactionList" styleClass="transaction-list" VBox.vgrow="ALWAYS"/>
    <Label    fx:id="messageLabel"   styleClass="message-label"/>
</VBox>
