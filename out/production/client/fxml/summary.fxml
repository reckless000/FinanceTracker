<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="client.controllers.SummaryController" spacing="20" alignment="CENTER" style="-fx-background-color: white;">
    <padding><Insets top="30" right="60" bottom="30" left="60"/></padding>
    <Label text="Financial Summary" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Separator/>
    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" minWidth="190" style="-fx-background-color: #E8F5E9; -fx-border-color: #A5D6A7; -fx-background-radius: 10; -fx-border-radius: 10;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Total Income" style="-fx-font-weight: bold; -fx-text-fill: #546E7A;"/>
            <Label fx:id="incomeValue" text="0.00" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
        </VBox>
        <VBox alignment="CENTER" minWidth="190" style="-fx-background-color: #FFEBEE; -fx-border-color: #EF9A9A; -fx-background-radius: 10; -fx-border-radius: 10;">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Total Expenses" style="-fx-font-weight: bold; -fx-text-fill: #546E7A;"/>
            <Label fx:id="expenseValue" text="0.00" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #C62828;"/>
        </VBox>
    </HBox>
    <VBox alignment="CENTER" minWidth="420" style="-fx-background-color: #E8EAF6; -fx-border-color: #9FA8DA; -fx-background-radius: 10; -fx-border-radius: 10;">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        <Label text="Net Balance" style="-fx-font-weight: bold; -fx-text-fill: #546E7A;"/>
        <Label fx:id="balanceValue" text="0.00" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #283593;"/>
    </VBox>
    <Region prefHeight="10"/>
    <Button fx:id="refreshBtn" text="Refresh Summary" maxWidth="300" style="-fx-background-color: #1E88E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6;"/>
    <Label fx:id="messageLabel" style="-fx-font-size: 12px;"/>
</VBox>