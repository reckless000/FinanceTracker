<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.controllers.LoginController"
      spacing="15"
      alignment="CENTER"
      styleClass="root-container"
      >
    <padding><Insets top="40" right="50" bottom="40" left="50"/></padding>

    <Label text="💰 Finance Tracker" styleClass="title-label"/>
    <Label text="Sign in to your account" styleClass="subtitle-label"/>
    <Region prefHeight="10"/>

    <VBox spacing="5">
        <Label text="Username" styleClass="field-label"/>
        <TextField fx:id="usernameField" promptText="Enter your username"
                   styleClass="input-field" maxWidth="300"/>
    </VBox>
    <VBox spacing="5">
        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="Enter your password"
                       styleClass="input-field" maxWidth="300"/>
    </VBox>
    <Region prefHeight="5"/>

    <Button fx:id="loginButton"    text="Login"          styleClass="btn-primary"   maxWidth="300"/>
    <Button fx:id="registerButton" text="Create Account" styleClass="btn-secondary" maxWidth="300"/>
    <Label  fx:id="messageLabel"   styleClass="message-label" wrapText="true" maxWidth="300"/>
</VBox>
